# The site reads the catalog straight from this Google Sheet — see README
# for how to create the service account and share the sheet with it.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared secret the browser extension sends as the X-Api-Key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EXTENSION_API_KEY=
